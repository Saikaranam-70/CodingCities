# Port for Express API server
PORT=5000

# Base URL of your stats service instance (cloned locally in /stats-api or deployed on Render)
STATS_API_URL=http://localhost:3000

# Optional Redis connection string (Render Redis add-on / Upstash).
# If unset, backend uses a fast in-memory cache for local development.
# REDIS_URL=redis://default:password@your-redis-host:6379

# Allowed CORS origins (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
